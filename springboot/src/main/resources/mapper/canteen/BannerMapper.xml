<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fast.canteen.mapper.BannerMapper">

    <resultMap type="Banner" id="BannerResult">
        <result property="bannerId"    column="banner_id"    />
        <result property="dishesId"    column="dishes_id"    />
        <result property="sort"    column="sort"    />
        <result property="name"    column="name"    />
        <result property="description"    column="description"    />
        <result property="price"    column="price"    />
        <result property="image"    column="image"    />
    </resultMap>

    <select id="selectBannerList" parameterType="Banner" resultMap="BannerResult">
        select b.banner_id, b.dishes_id, b.sort,
               d.name, d.description, d.price, d.image
        from banner b
        left join dishes d on b.dishes_id = d.dishes_id
        <where>
            <if test="dishesId != null  and dishesId != ''">
                and b.dishes_id like concat('%', #{dishesId}, '%')
            </if>
        </where>
        order by b.sort
    </select>

    <select id="selectBannerByBannerId" parameterType="String" resultMap="BannerResult">
select banner_id, dishes_id, sort from banner
        where banner_id = #{bannerId}
    </select>

    <insert id="insertBanner" parameterType="Banner">
        insert into banner
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="bannerId != null">banner_id,</if>
            <if test="dishesId != null and dishesId != ''">dishes_id,</if>
            <if test="sort != null">sort,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="bannerId != null">#{bannerId},</if>
            <if test="dishesId != null and dishesId != ''">#{dishesId},</if>
            <if test="sort != null">#{sort},</if>
         </trim>
    </insert>

    <update id="updateBanner" parameterType="Banner">
        update banner
        <trim prefix="SET" suffixOverrides=",">
            <if test="dishesId != null and dishesId != ''">dishes_id = #{dishesId},</if>
            <if test="sort != null">sort = #{sort},</if>
        </trim>
        where banner_id = #{bannerId}
    </update>

    <delete id="deleteBannerByBannerId" parameterType="String">
        delete from banner where banner_id = #{bannerId}
    </delete>

    <delete id="deleteBannerByBannerIds" parameterType="String">
        delete from banner where banner_id in
        <foreach item="bannerId" collection="array" open="(" separator="," close=")">
            #{bannerId}
        </foreach>
    </delete>
</mapper>
